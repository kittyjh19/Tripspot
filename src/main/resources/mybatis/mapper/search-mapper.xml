<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.multi.semiproject.search.model.dao.SearchMapper">

    <!-- 특정 키워드에 해당하는 관광지 개수를 조회 -->
    <select id="getTotalCountByKeyword" resultType="int">
        SELECT COUNT(*)
        FROM travel
        WHERE name LIKE CONCAT('%', #{keyword}, '%')
    </select>

    <!-- 특정 키워드로 관광지 목록을 검색 -->
    <select id="getSearchResults" resultType="com.multi.semiproject.search.model.dto.SearchResultDTO">
        SELECT district, title, address, phone
        FROM travel
        WHERE name LIKE CONCAT('%', #{keyword}, '%')
    </select>

    <!-- 특정 권역의 관광지 목록을 조회 -->
    <select id="getSearchResultsByRegion" resultType="com.multi.semiproject.search.model.dto.SearchResultDTO">
        SELECT district, title, address, phone
        FROM travel
        WHERE district = #{district}
    </select>

</mapper>

<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.multi.semiproject.board.model.dao.BoardMapper">

    <resultMap id="boardResultMap" type="com.multi.semiproject.board.model.dto.BoardDTO">
        <id property="board_no" column="board_no" />
        <id property="board_type" column="board_type" />
        <result property="title" column="title" />
        <result property="content" column="content" />
        <result property="viewCount" column="view_count" />
        <result property="createdAt" column="created_at" />
    </resultMap>

    <select id="selectAllBoards" resultMap="boardResultMap">
        SELECT * FROM board
        ORDER BY is_notice DESC, created_at DESC
    </select>

    <select id="selectBoardById" resultMap="boardResultMap">
        SELECT * FROM board WHERE id = #{id}
    </select>

    <insert id="insertBoard">
        INSERT INTO board (title, content, writer, is_notice, view_count, created_at)
        VALUES (#{title}, #{content}, #{writer}, #{isNotice}, 0, NOW())
    </insert>

    <update id="updateBoard">
        UPDATE board
        SET title = #{title}, content = #{content}, is_notice = #{isNotice}
        WHERE id = #{id}
    </update>

    <delete id="deleteBoard">
        DELETE FROM board WHERE id = #{id}
    </delete>

    <update id="increaseViewCount">
        UPDATE board SET view_count = view_count + 1 WHERE id = #{id}
    </update>

</mapper>
